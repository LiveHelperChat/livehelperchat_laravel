# Copy to .env and fill in (never commit real credentials).

# Admin credentials used by tests/auth.setup.ts to log in once and by the
# login-page spec. They match the operator created by:
#   php artisan lhc:admin admin admin
LHC_USERNAME=admin
LHC_PASSWORD=admin

# Shared secret that lets the demo page be opened without an admin login.
# It must match the E2E_SECRET value configured on the target instance.
E2E_SECRET=

# Optional: target a different instance. Defaults to the local Laravel app,
# which Playwright boots automatically on http://127.0.0.1:8000.
# BASE_URL=http://127.0.0.1:8000
